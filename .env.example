# 配置后使用 mint --config ./mint.env 加载，或将下列值设为环境变量。
# 优先级：命令行参数 > 进程环境变量 > 配置文件 > 默认值。
ROOT_DIR=/absolute/path/to/files
USERNAME=mint
# 使用 mint --passwd your_password 生成，再将输出的完整哈希填入单引号内。
PASSWORD_HASH='$2b$12$replace-with-generated-hash'
HOST=0.0.0.0
PORT=8001
# 通过 HTTPS 反向代理访问时可设为 true。
COOKIE_SECURE=false
